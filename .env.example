# Copie este archivo como .env y ponga sus datos locales (el .env NO se sube a GitHub)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=su_contraseña_aqui
DB_NAME=hotel_corte_vertical

# Puerto de la API: http://localhost:3000/api
PORT=3000

# Origen(es) de la interfaz (semana 3) separados por coma, para CORS
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
